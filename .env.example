############################################################################
#  KARGO HIRING — KEYS & CONFIG
#  Fill in each value after the "=" (no quotes, no spaces around "=").
#  This file is in .gitignore — it will NOT be pushed to GitHub.
#  When deploying on Vercel: Project → Settings → Environment Variables →
#  "Import .env" and paste everything below (or copy to .env.local to run locally).
############################################################################

# ---- SUPABASE (project "Kargo Hiring", already created, table already set up) ----
# URL is filled in for you.
SUPABASE_URL=
# Supabase dashboard → Kargo Hiring → Project Settings → API Keys →
# "Secret keys" (sb_secret_...) or legacy "service_role". SERVER-ONLY, never share.
SUPABASE_SERVICE_ROLE_KEY=

# ---- GEMINI ----
# https://aistudio.google.com/apikey → Create API key
GEMINI_API_KEY=
# Optional: change model. Default is gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# ---- RESEND ----
# https://resend.com/api-keys → Create API key (Sending access)
RESEND_API_KEY=
# Without a verified domain, Resend only lets you send FROM onboarding@resend.dev
# and only TO the email address you signed up to Resend with.
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# For testing: send every email to this address instead of the candidate
# (use your Resend signup email). Leave blank to send to real candidates.
EMAIL_OVERRIDE_TO=
# Optional: where candidate replies go
REPLY_TO=

# ---- APP LOGIN ----
# No longer used for login (the app has a one-click Enter button).
# Optional: changing it signs everyone out.
APP_PASSWORD=

############################################################################
